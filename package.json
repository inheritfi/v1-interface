{
  "name": "v1-interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "build": "node scripts/generate-contracts.mjs --check && node scripts/i18n-check.mjs && tsc -b && vite build",
    "check:i18n": "node scripts/i18n-check.mjs",
    "build:site": "node scripts/generate-contracts.mjs --check && node scripts/i18n-check.mjs && tsc -b && vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr && node scripts/prerender-site.mjs",
    "preview:site": "vite preview --config vite.site.config.ts",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@babel/helpers": "7.29.7",
    "@babel/traverse": "7.29.8",
    "acorn": "8.18.0",
    "baseline-browser-mapping": "2.11.27",
    "caniuse-lite": "1.0.30001814",
    "electron-to-chromium": "1.5.444",
    "magic-string": "1.4.2",
    "nanoid": "3.3.19",
    "node-releases": "2.0.57",
    "postcss": "8.5.28",
    "rolldown": "1.2.11",
    "tinybench": "6.2.0",
    "update-browserslist-db": "1.3.3",
    "ws": "8.21.3",
    "zod": "4.6.6"
  }
}
